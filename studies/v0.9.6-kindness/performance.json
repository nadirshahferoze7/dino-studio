  "captions": [
    {
      "start": 0.6910000000000001,
      "end": 1.92,
      "text": "Hey, friends."
    },
    {
      "start": 1.92,
      "end": 6.447,
      "text": "Our time together is too precious to spend making someone feel small."
    },
    {
      "start": 6.447,
      "end": 10.6,
      "text": "Making fun of someone can hurt, even when we call it a joke."
    },
    {
      "start": 11.216,
      "end": 13.971,
      "text": "If someone feels hurt, let's stop and listen."
    },
    {
      "start": 13.971,
      "end": 15.575000000000001,
      "text": "We all make mistakes."
    },
    {
      "start": 15.575000000000001,
      "end": 18.25,
      "text": "What matters is what we choose next."
    },
    {
      "start": 18.945,
      "end": 23.109,
      "text": "We can say sorry, make things right, and help someone feel included."
    },
    {
      "start": 23.109,
      "end": 25.804000000000002,
      "text": "It's never too late to choose kindness."
    },
    {
      "start": 25.804000000000002,
      "end": 26.585,
      "text": "You matter."
    },
    {
      "start": 26.585,
      "end": 27.704,
      "text": "They matter too."
    },
    {
      "start": 27.704,
      "end": 29.9,
      "text": "Let's make room for everyone."
